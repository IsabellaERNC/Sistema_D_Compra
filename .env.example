# ============================================
# Variables de Entorno — Sistema_D_Compra
# ============================================
# Copia este archivo a backend/.env y completa los valores.
# NUNCA subas .env al repositorio.
# ============================================

# ── Servicios Externos ──
AUTH_SERVICE_URL=http://localhost:4000
AUTH_API_KEY=

PRODUCTOS_SERVICE_URL=http://localhost:4001

PAGOS_SERVICE_URL=http://localhost:4002
PAGOS_WEBHOOK_SECRET=200603

NOTIFICACIONES_SERVICE_URL=http://localhost:4003

# ── JWT (DEV_MODE) ──
JWT_SECRET=clave_segura_cambiar_en_produccion
DEV_MODE=true

# ── Base de Datos ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=sistema_compras

# ── URLs del Frontend ──
TU_LOCAL_URL=http://localhost:5173
URL_PAGO_OK=http://localhost:5173/pages/confirmacion.html?status=ok
URL_PAGO_ERROR=http://localhost:5173/pages/confirmacion.html?status=error
