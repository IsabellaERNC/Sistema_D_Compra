# ============================================
# Variables de Entorno — Sistema_D_Compra
# ============================================
# Copia este archivo a backend/.env y completa los valores.
# NUNCA subas .env al repositorio.
#
# CONFIGURACIÓN PARA GOOGLE CLOUD RUN
# ============================================

# ── Microservicios (Cloud Run) ──
# Reemplazar xxxxx-REGION con las URLs reales de tus servicios Cloud Run
AUTH_SERVICE_URL=https://auth-xxxxx-REGION.a.run.app
AUTH_API_KEY=tu_api_key_auth

PRODUCTOS_SERVICE_URL=https://catalogo-inventario-988961931787.us-central1.run.app

PAGOS_SERVICE_URL=https://pagos-xxxxx-REGION.a.run.app
PAGOS_WEBHOOK_SECRET=clave_segura_cambiar_en_produccion
PAGOS_API_KEY=tu_api_key_pagos

NOTIFICACIONES_SERVICE_URL=https://notificaciones-xxxxx-REGION.a.run.app

ENVIOS_SERVICE_URL=https://envios-xxxxx-REGION.a.run.app

# ── JWT ──
JWT_SECRET=clave_segura_cambiar_en_produccion

# ── Base de Datos (Cloud SQL) ──
# Opción A — Unix Socket (recomendada para Cloud Run + VPC):
DB_HOST=/cloudsql/INSTANCE_CONNECTION_NAME
# Opción B — IP pública con SSL:
# DB_HOST=1.2.3.4
# DB_SSL=true
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=contraseña_segura
DB_NAME=sistema_d_compra
DB_SSL=false

# ── CORS ──
# Dominios permitidos para CORS (separados por coma)
CORS_ORIGINS=https://midominio.com,https://admin.midominio.com

# ── URLs de redirección MercadoPago ──
# Deben ser URLs públicas accesibles desde MercadoPago
URL_PAGO_OK=https://midominio.com/confirmacion?status=ok
URL_PAGO_ERROR=https://midominio.com/confirmacion?status=error

# ── Puerto del servidor (opcional, default 3000) ──
PORT=3000

# ── Frontend (para construir en Cloud Run Buildpacks) ──
VITE_API_URL=https://carrito-xxxxx-REGION.a.run.app
VITE_AUTH_URL=https://auth-xxxxx-REGION.a.run.app
VITE_CATALOGO_URL=https://catalogo-xxxxx-REGION.a.run.app

# ============================================
# 🔐  SECRETS MANAGER (producción real)
# ============================================
# En produccion usa Google Cloud Secret Manager:
#   gcloud run deploy carrito \
#     --update-secrets=JWT_SECRET=JWT_SECRET:latest,DB_PASSWORD=DB_PASSWORD:latest
#
# Variables recomendadas para Secrets Manager:
#   - JWT_SECRET
#   - DB_PASSWORD
#   - PAGOS_WEBHOOK_SECRET
#   - AUTH_API_KEY
#   - PAGOS_API_KEY

# ============================================
# 📋  CHECKLIST DE DESPLIEGUE CLOUD RUN
# ============================================
# [ ] 1. Crear Cloud SQL instance con PostgreSQL 15
# [ ] 2. Crear base de datos: CREATE DATABASE sistema_d_compra;
# [ ] 3. Ejecutar database/schema_completo.sql contra la DB
# [ ] 4. Desplegar CADA microservicio como Cloud Run service independiente
# [ ] 5. Configurar VPC connector o Serverless VPC Access para Cloud SQL
# [ ] 6. Configurar dominio personalizado + SSL
# [ ] 7. Crear service accounts con permisos mínimos
# [ ] 8. Configurar Secrets Manager para secrets sensibles
# [ ] 9. Configurar Cloud Build CI/CD
# [ ] 10. Probar health check: GET <URL>/health
